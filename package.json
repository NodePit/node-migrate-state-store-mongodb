{
  "name": "@nodepit/migrate-state-store-mongodb",
  "version": "5.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "lint": "pnpm run lint:eslint && pnpm run lint:format && pnpm run lint:knip && pnpm run lint:types && pnpm run lint:changelog",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:knip": "knip",
    "lint:types": "tsc --noEmit",
    "lint:changelog": "changelog-keeper lint --section-types Added,Changed,Deprecated,Removed,Fixed,Security,Breaking",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"['./coverage', './dist'].forEach(entry => require('fs').rmSync(entry, { recursive: true, force: true }));\"",
    "preversion": "pnpm run clean && pnpm run lint && pnpm test && pnpm run build",
    "version": "changelog-keeper verify --section-types Added,Changed,Deprecated,Removed,Fixed,Security,Breaking || (git checkout -- package.json && exit 1)",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@qqilihq/changelog-keeper": "0.1.0-beta.3",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "husky": "^9.1.7",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1",
    "migrate": "^2.1.0",
    "mongodb": "^6.8.0",
    "mongodb-memory-server-global": "^9.2.0",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "migrate": "^2.0.0",
    "mongodb": "^5.0.0 || ^6.0.0"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NodePit/node-migrate-state-store-mongodb.git"
  },
  "keywords": [
    "mongodb",
    "migrate",
    "state-store"
  ],
  "author": "nodepit.com",
  "bugs": {
    "url": "https://github.com/NodePit/node-migrate-state-store-mongodb/issues"
  },
  "homepage": "https://github.com/NodePit/node-migrate-state-store-mongodb#readme",
  "description": "MongoDB-based state storage implementation for the migrate aka. node-migrate framework",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.5",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.28.13"
}
